---
---
<div transition:persist="audio-player" class="fixed bottom-6 right-6 z-50">
  <button id="audio-toggle" class="bg-primary text-white w-12 h-12 rounded-full shadow-lg flex items-center justify-center hover:bg-opacity-90 transition-all duration-300 focus:outline-none" aria-label="Play/Pause Music">
    <!-- Play Icon -->
    <svg id="icon-play" class="w-5 h-5 ml-1" fill="currentColor" viewBox="0 0 24 24">
      <path d="M8 5v14l11-7z" />
    </svg>
    <!-- Pause Icon (Initially Hidden) -->
    <svg id="icon-pause" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24">
      <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
    </svg>
  </button>

  <audio id="bg-music" loop>
    <source src={import.meta.env.BASE_URL.replace(/\/$/, "") + "/audio/sample.mp3"} type="audio/mpeg">
  </audio>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const audio = document.getElementById('bg-music') as HTMLAudioElement;
    const btn = document.getElementById('audio-toggle');
    const iconPlay = document.getElementById('icon-play');
    const iconPause = document.getElementById('icon-pause');

    if (audio && btn && iconPlay && iconPause) {
      // Restore state if playing (optional, can be complex with ViewTransitions, simple check for now)
      if (!audio.paused) {
         iconPlay.classList.add('hidden');
         iconPause.classList.remove('hidden');
      }

      btn.addEventListener('click', () => {
        if (audio.paused) {
          audio.play().catch(e => console.error("Playback failed:", e));
          iconPlay.classList.add('hidden');
          iconPause.classList.remove('hidden');
        } else {
          audio.pause();
          iconPlay.classList.remove('hidden');
          iconPause.classList.add('hidden');
        }
      });
    }
  });
</script>
