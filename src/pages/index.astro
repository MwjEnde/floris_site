---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const homeEntries = await getCollection('home');
const homeEntry = homeEntries[0];
const homeData = homeEntry.data;
const { Content } = await homeEntry.render();
---

<Layout 
  title={homeData.metaTitle} 
  description={homeData.metaDescription}
  schemaType="Person"
>
	<section class="flex flex-col items-center justify-center text-center space-y-8 min-h-[80vh]">
    <div class="w-full max-w-4xl shadow-xl mb-8">
      <img src={import.meta.env.BASE_URL.replace(/\/$/, "") + homeData.heroImage} alt="Floris aan de piano" class="w-full h-auto" />
    </div>
		<h1 class="text-5xl md:text-7xl font-serif font-light text-primary tracking-tight">
			{homeData.title}
		</h1>
		<p class="text-xl md:text-2xl font-serif italic text-gray-600 max-w-2xl leading-relaxed">
			"{homeData.subtitle}"
		</p>


    <div class="prose prose-lg prose-serif text-gray-600 max-w-2xl mx-auto pt-12 leading-loose">
      <Content />
    </div>
	</section>
</Layout>
