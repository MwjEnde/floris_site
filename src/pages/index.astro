---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
	<section class="flex flex-col items-center justify-center text-center space-y-8 min-h-[80vh]">
    <div class="w-full max-w-4xl shadow-xl mb-8">
      <img src={import.meta.env.BASE_URL + "/Foris_piano_neutral.jpg"} alt="Floris aan de piano" class="w-full h-auto" />
    </div>
		<h1 class="text-5xl md:text-7xl font-serif font-light text-primary tracking-tight">
			Floris
		</h1>
		<p class="text-xl md:text-2xl font-serif italic text-gray-600 max-w-2xl leading-relaxed">
			"Muziek is de stilte tussen de noten."
		</p>
    <div class="pt-8">
      <a href={import.meta.env.BASE_URL.replace(/\/$/, "") + "/concerten"} class="inline-block border border-primary px-8 py-3 text-sm uppercase tracking-widest hover:bg-primary hover:text-white transition-colors duration-300">
        Bekijk Agenda
      </a>
    </div>
	</section>
</Layout>
