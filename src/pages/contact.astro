---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <div class="max-w-xl mx-auto text-center space-y-12">
    <h1 class="text-4xl font-serif font-light">Contact</h1>
    
    <div class="space-y-2">
      <p class="text-lg font-serif italic text-gray-600">Voor boekingen en informatie</p>
      <div class="h-px w-12 bg-gray-200 mx-auto my-4"></div>
      <p class="font-body text-primary">
        <a href="mailto:info@floris-pianist.nl" class="hover:text-gray-500 transition-colors">info@floris-pianist.nl</a>
      </p>
      <p class="font-body text-primary">
        +31 (0)6 1234 5678
      </p>
    </div>

    <div class="pt-8">
      <form id="contact-form" class="space-y-6 text-left" action="https://formspree.io/f/mzdzkwyj" method="POST">
        <div>
          <label for="name" class="block text-xs uppercase tracking-widest text-primary/60 mb-2">Naam</label>
          <input type="text" id="name" name="name" class="w-full border-b border-primary/20 py-2 focus:outline-none focus:border-primary transition-colors font-serif bg-transparent" required />
        </div>
        <div>
          <label for="email" class="block text-xs uppercase tracking-widest text-primary/60 mb-2">Email</label>
          <input type="email" id="email" name="email" class="w-full border-b border-primary/20 py-2 focus:outline-none focus:border-primary transition-colors font-serif bg-transparent" required />
        </div>
        <div>
          <label for="message" class="block text-xs uppercase tracking-widest text-primary/60 mb-2">Bericht</label>
          <textarea id="message" name="message" rows="5" class="w-full border-b border-primary/20 py-2 focus:outline-none focus:border-primary transition-colors font-serif bg-transparent resize-none" required></textarea>
        </div>
        <div class="text-center pt-8">
          <button type="submit" id="submit-btn" class="border border-primary px-12 py-4 text-xs uppercase tracking-widest hover:bg-primary hover:text-white transition-all duration-300">
            Versturen
          </button>
        </div>
        <p id="form-status" class="text-center text-sm font-serif italic mt-4 hidden"></p>
      </form>
    </div>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('form-status');
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;

    if (form && status && btn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Disable button
        btn.disabled = true;
        btn.textContent = 'Versturen...';
        status.classList.add('hidden');
        status.className = "text-center text-sm font-serif italic mt-4 hidden"; // Reset classes

        const data = new FormData(form);

        try {
          const response = await fetch(form.action, {
            method: form.method,
            body: data,
            headers: {
                'Accept': 'application/json'
            }
          });

          if (response.ok) {
            status.textContent = "Bedankt voor uw bericht. Ik neem zo spoedig mogelijk contact op.";
            status.classList.remove('hidden', 'text-red-500');
            status.classList.add('text-green-600');
            form.reset();
            btn.textContent = 'Verstuurd';
          } else {
            const result = await response.json();
             if (Object.hasOwn(result, 'errors')) {
                status.textContent = result["errors"].map((error: any) => error["message"]).join(", ");
             } else {
                status.textContent = "Er is iets misgegaan. Probeer het later opnieuw.";
             }
            status.classList.remove('hidden');
            status.classList.add('text-red-500');
            btn.disabled = false;
            btn.textContent = 'Versturen';
          }
        } catch (error) {
          status.textContent = "Er is een fout opgetreden bij het versturen.";
          status.classList.remove('hidden');
          status.classList.add('text-red-500');
          btn.disabled = false;
          btn.textContent = 'Versturen';
        }
      });
    }
  });
</script>
  </div>
</Layout>
