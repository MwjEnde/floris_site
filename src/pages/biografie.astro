---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const bioEntries = await getCollection('biography');
const bio = bioEntries[0]; // Assuming single entry for now as discussed
const { Content } = await bio.render();
---

<Layout title="Biografie">
  <article class="prose prose-lg prose-serif mx-auto text-justify">
    <h1 class="text-4xl font-serif font-light text-center mb-12">{bio.data.title}</h1>
    
    {bio.data.portrait && (
    {bio.data.portrait && (
      <div class="rounded-full overflow-hidden w-64 h-64 md:w-80 md:h-80 mx-auto mb-12 shadow-xl border-4 border-white/50">
        <img src={import.meta.env.BASE_URL + bio.data.portrait} alt="Floris" class="w-full h-full object-cover" />
      </div>
    )}
    )}

    <div class="font-body text-gray-800 leading-loose">
      <Content />
    </div>
  </article>
</Layout>
