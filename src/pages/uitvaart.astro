---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const uitvaartEntries = await getCollection('uitvaart');
const uitvaartEntry = uitvaartEntries[0];
const data = uitvaartEntry.data;
const { Content } = await uitvaartEntry.render();
---

<Layout 
  title={data.metaTitle || data.title} 
  description={data.metaDescription}
  schemaType="LocalBusiness"
>
  <article class="prose prose-lg prose-serif mx-auto text-justify">
    <h1 class="text-4xl font-serif font-light text-center mb-12">{data.title}</h1>
    
    <div class="font-body text-gray-800 leading-loose space-y-6">
      <Content />
      
      <div class="not-prose bg-gray-50 p-8 rounded border border-gray-100 mt-12 text-center">
        <h3 class="text-xl font-serif mb-4">{data.ctaTitle}</h3>
        <p class="text-sm font-sans text-gray-600 mb-6">{data.ctaText}</p>
        <a href={import.meta.env.BASE_URL.replace(/\/$/, "") + data.ctaButtonLink} class="inline-block border border-primary px-8 py-2 text-xs uppercase tracking-widest hover:bg-primary hover:text-white transition-colors">
          {data.ctaButtonText}
        </a>
      </div>
    </div>
  </article>
</Layout>
