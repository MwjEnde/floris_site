---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import AudioPlayer from '../components/AudioPlayer.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Website van Floris, klassiek pianist" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Floris - Klassiek Pianist</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
		<ViewTransitions />
	</head>
	<body class="bg-white text-primary font-body antialiased flex flex-col min-h-screen pb-20">
    <Header />
		<main class="flex-grow w-full max-w-4xl mx-auto px-6 py-12 md:py-20">
			<slot />
		</main>
    <footer class="py-6 text-center text-sm text-gray-500 font-serif">
      &copy; {new Date().getFullYear()} Floris van den Ende. Alle rechten voorbehouden.
    </footer>
    <AudioPlayer />
	</body>
</html>
